# Required for writing replies (free key from openrouter.ai/keys)
OPENROUTER_API_KEY=

# Leave blank: Reply Radar picks a working free chat model itself and falls back if one is busy.
# Or set one or more comma-separated model ids to try first, e.g. google/gemma-4-31b-it:free
OPENROUTER_MODEL=

# Your own handle. Your posts are skipped when importing.
MY_HANDLE=

PORT=3000
